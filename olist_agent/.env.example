# ========================================
# Olist 电商数据智能分析 Agent
# 基于 LangChain + LangGraph + Streamlit
# ========================================

# API Key 配置（复制 .env.example 为 .env 再填入）
# 推荐用国产大模型：
# - 阿里通义: https://dashscope.console.aliyun.com/  (免费额度大)
# - 百度千帆: https://console.bce.baidu.com/qianfan/
# - 硅基流动: https://siliconflow.cn/  (支持 OpenAI 兼容接口)
# ========================================

# 任选一个你能拿到 API Key 的，支持 OpenAI 兼容格式：
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
